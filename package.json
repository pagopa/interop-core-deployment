{
  "name": "interop-core-deployment",
  "version": "1.0.0",
  "type": "module",
  "description": "Interop Core Deployment - ArgoCD and Kubernetes manifests",
  "main": "index.js",
  "scripts": {
    "list-external-secrets": "npm run build:secret-references && node dist/scripts/external-secrets-generator/list-external-secrets.js",
    "build:secret-references": "tsc -p tsconfig.json",
    "secret-references-repo-inventory": "npm run build:secret-references && node dist/scripts/external-secrets-generator/secret-references-repo-inventory.js",
    "secret-references-cluster-inventory": "npm run build:secret-references && node dist/scripts/external-secrets-generator/secret-references-cluster-inventory.js",
    "secret-references-compare": "npm run build:secret-references && node dist/scripts/external-secrets-generator/secret-references-compare.js",
    "secret-references-external-secrets-generator": "npm run build:secret-references && node dist/scripts/external-secrets-generator/secret-references-external-secrets-generator.js",
    "secret-references-external-secrets-validator": "npm run build:secret-references && node dist/scripts/external-secrets-generator/secret-references-external-secrets-validator.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "argocd",
    "kubernetes",
    "external-secrets",
    "kustomize",
    "helm"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1165.0",
    "@kubernetes/client-node": "^1.4.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "vite": "^6.4.6",
    "ip-address": "^10.7.6",
    "postcss": "^8.5.32",
    "nanoid": "^3.3.20",
    "js-yaml": "^4.3.2"

  }
}
